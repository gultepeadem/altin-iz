# Altın İz — Ortam Değişkenleri Örneği
#
# Bu dosya projeye katılan geliştiricilere hangi ortam değişkenlerinin
# gerektiğini gösterir. Gerçek anahtarlar bu dosyaya YAZILMAZ.
#
# Kullanım:
#   1. Bu dosyayı `.env.local` olarak kopyalayın.
#   2. Her değişkene gerçek değeri yazın.
#   3. `.env.local` dosyası .gitignore tarafından dışlanır; Git'e eklenmez.
#
# Güvenlik uyarısı:
#   - Supabase secret key, service role key ve fiyat API anahtarı
#     bu dosyaya veya mobil uygulamaya yazılmamalıdır.
#   - Yalnızca EXPO_PUBLIC_ önekli değişkenler istemcide görünür.

# Supabase proje URL'si (Dashboard → Settings → API → Project URL)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (Dashboard → Settings → API → anon public)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Uygulama ortamı: development | preview | production
EXPO_PUBLIC_APP_ENV=development
